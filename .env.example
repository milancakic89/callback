# Supabase project settings: Project URL and API keys. Server-only, never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Public origin of the app, used for links in emails. Production: https://your-domain.com
APP_URL=http://localhost:3000

# SMTP for transactional email (nodemailer). Gmail: enable 2FA, then create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
MAIL_FROM="Job Manager <you@gmail.com>"

# Optional: shared by the app and the scraper. After `publish`/`boards` write jobs, the scraper calls
# POST $APP_URL/api/jobs/revalidate with it, so the dashboard shows them right away instead of within
# the hour. At least 32 characters; generate with `openssl rand -hex 32`. Unset disables the route.
# REVALIDATE_SECRET=

# Optional, for `npm run scrape -- boards`: a free Himalayas API key (himalayas.app/docs/remote-jobs-api)
# raises the limit to 60 requests/min. Without one, every caller shares one public allowance.
# HIMALAYAS_API_KEY=
